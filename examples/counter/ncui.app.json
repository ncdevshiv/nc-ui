{
  "name": "counter",
  "identity": "com.ncui.counter",
  "scheme": "ncui-counter",
  "version": "1.0.0",
  "entry": "index.html",
  "assets": "public",
  "default_locale": "en",
  "window": {
    "title": "NC-UI Counter",
    "width": 900,
    "height": 640,
    "min_width": 420,
    "min_height": 320
  },
  "capabilities": [
    "read.metrics",
    "filesystem.read",
    "run.components",
    "window"
  ],
  "shortcuts": [
    {
      "accelerator": "Ctrl+Alt+N",
      "command": "increment"
    }
  ],
  "menus": [
    {
      "label": "Counter",
      "items": [
        { "type": "item", "label": "Increment", "command": "increment" },
        { "type": "separator" },
        {
          "type": "submenu",
          "label": "Window",
          "items": [
            { "type": "item", "label": "Open notes", "command": "notes" },
            { "type": "item", "label": "Toggle fullscreen", "command": "fullscreen" }
          ]
        }
      ]
    }
  ],
  "page_commands": [
    {
      "command": "counter.summary",
      "requires": [],
      "summary": "The page's own summary of the counter, answered in JavaScript"
    }
  ]
}
