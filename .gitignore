target/
**/*.rs.bk
*.pdb
*.ilk
/bench-baseline
.env
*.local.toml
# Benchmark output is regenerated on every run. The baseline under
# benches/baseline/ is a committed artefact and is deliberately tracked.
/benches/results

# Release artefacts are regenerated by tools/build_release.py and signed per-release; the
# committed MANIFEST would be a stale claim the moment anything changed.
artifacts/
# Application bundles are regenerated by `ncui build` (the Makefile's `bundle` target).
/dist/
# cargo-cyclonedx writes one document per crate next to its manifest.
*.cdx.json

# Python bytecode from the tools/ scripts. Regenerated on every run.
__pycache__/
*.pyc

# The agent-coordination roster and journal are machine-local session state, not source.
# Committing them would put a rotating append-only log into the history of every clone.
.nc-tools/

# The cross-framework comparison clones third-party applications and writes runtime
# benchmark files beside the ports. Both are regenerated by comparison/bench/compare.py.
/comparison/.originals/
/comparison/ports/*/bench-config.json
/comparison/ports/*/bench-result.json
/comparison/bench/results/smoke.json
